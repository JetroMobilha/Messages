<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/vault_contact_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/tiny_margin"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/two_line_list_item_min_height"
    android:paddingStart="@dimen/activity_margin"
    android:paddingTop="@dimen/medium_margin"
    android:paddingEnd="@dimen/activity_margin"
    android:paddingBottom="@dimen/medium_margin"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/vault_contact_image"
        android:layout_width="@dimen/list_icon_size_medium"
        android:layout_height="@dimen/list_icon_size_medium"
        app:layout_constraintBottom_toBottomOf="@id/vault_contact_snippet"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/vault_contact_name"
        tools:src="@mipmap/ic_launcher" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/vault_contact_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/activity_margin"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textDirection="locale"
        android:textSize="@dimen/list_primary_text_size"
        app:layout_constraintBottom_toTopOf="@id/vault_contact_snippet"
        app:layout_constraintEnd_toStartOf="@id/vault_contact_date"
        app:layout_constraintStart_toEndOf="@id/vault_contact_image"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="John Doe" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/vault_contact_snippet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/activity_margin"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textDirection="locale"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/vault_contact_unread_count"
        app:layout_constraintStart_toEndOf="@id/vault_contact_image"
        app:layout_constraintTop_toBottomOf="@id/vault_contact_name"
        tools:text="Mensagem furtiva..." />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/vault_contact_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/smaller_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/vault_contact_name"
        tools:text="14:20" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/vault_contact_unread_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/item_received_background"
        android:gravity="center"
        android:minWidth="24dp"
        android:paddingHorizontal="@dimen/small_margin"
        android:textAlignment="center"
        android:textSize="@dimen/smaller_text_size"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/vault_contact_snippet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/vault_contact_snippet"
        tools:text="2"
        tools:visibility="visible" />

        <ImageView
        android:id="@+id/vault_contact_block_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_cross_vector"
        android:contentDescription="Bloqueio de Chamada Ativo"
        app:layout_constraintBottom_toBottomOf="@id/vault_contact_name"
        app:layout_constraintEnd_toStartOf="@id/vault_contact_date"
        app:layout_constraintTop_toTopOf="@id/vault_contact_name" />

</androidx.constraintlayout.widget.ConstraintLayout>
