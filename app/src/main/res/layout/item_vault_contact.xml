<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vault_contact_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?attr/selectableItemBackground">

    <org.fossify.commons.views.MyTextView
        android:id="@+id/vault_contact_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/vault_contact_number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/vault_contact_policy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="italic" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/vault_contact_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingTop="8dp">

        <ImageView
            android:id="@+id/vault_contact_block_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_cross_vector"
            app:tint="#E53935"
            android:contentDescription="Bloqueio de Chamada Ativo"
            android:layout_marginEnd="16dp" />

        <ImageView
            android:id="@+id/vault_contact_dialer_btn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_phone_vector"
            app:tint="#4CAF50"
            android:contentDescription="Ligar de Volta"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

</LinearLayout>
