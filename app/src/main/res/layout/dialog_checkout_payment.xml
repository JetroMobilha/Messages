<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/checkout_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checkout Pro - Gateway Híbrido"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="12dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/checkout_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nome de Utilizador"
                android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/checkout_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Telefone (ex: +244 923 000 000)"
                android:inputType="phone" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/checkout_start_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Processar Pagamento Automático" />

        <LinearLayout
            android:id="@+id/multicaixa_details_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="12dp"
            android:background="#10000000">

            <org.fossify.commons.views.MyTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🇦🇴 Dados de Pagamento Multicaixa (Angola)"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/mc_entity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Entidade: 10203" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/mc_reference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Referência: --- --- ---"
                android:textStyle="bold" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/mc_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Valor: 5.000,00 AOA"
                android:paddingBottom="8dp" />

            <org.fossify.commons.views.MyTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:text="Pague via Multicaixa Express ou no Caixa Eletrónico. O seu acesso Pro será ativado automaticamente assim que o pagamento for confirmado." />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/international_details_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="12dp"
            android:background="#10000000">

            <org.fossify.commons.views.MyTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌐 Pagamento Internacional (Paddle / Visa / Mastercard)"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/int_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Valor: $4.99 USD"
                android:paddingBottom="8dp" />

            <org.fossify.commons.views.MyTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:text="Redirecionando para o portal seguro de cartão de crédito/PayPal internacional..." />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
